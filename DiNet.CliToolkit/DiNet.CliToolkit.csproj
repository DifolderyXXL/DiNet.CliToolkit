<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	  <GeneratePackageOnBuild>false</GeneratePackageOnBuild>

	  <PackageOutputPath>./nupkg</PackageOutputPath>
	  
	  <PackageId>DiNet.CliToolkit</PackageId>
	  <Version>0.0.3</Version>
	  <Authors>DifolderyXXL</Authors>
	  <PackageReadmeFile>README.md</PackageReadmeFile>
	  <Description>Cli toolkit for One-command-call. Supports native DI.</Description>
	  <RepositoryUrl>https://github.com/DifolderyXXL/DiNet.CliToolkit</RepositoryUrl>
	  <PackageTags>cli;tool;command</PackageTags>
	  <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeReferencedProjectsInPackage</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>

	<ItemGroup>
		<None Include="..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
	</ItemGroup>

	<Target Name="IncludeReferencedProjectsInPackage" DependsOnTargets="ResolveReferences">
		<ItemGroup>
			<BuildOutputInPackage Include="@(ReferenceCopyLocalPaths->WithMetadataValue('ReferenceSourceTarget', 'ProjectReference'))" />
		</ItemGroup>
	</Target>

	<ItemGroup>
		<ProjectReference Include="..\DiNet.CliToolkit.Core\DiNet.CliToolkit.Core.csproj" PrivateAssets="all" />
		<ProjectReference Include="..\DiNet.CliToolkit.Infrastructure\DiNet.CliToolkit.Infrastructure.csproj" PrivateAssets="all" />
	</ItemGroup>

</Project>
